{
  "schema_version": 1,
  "name": "php-serializer",
  "title": "PHP 序列化 / 反序列化",
  "description": "JSON 与 PHP serialize 格式转换，仅支持标量和数组；拒绝对象及非规范序列化数据。",
  "version": "1.0.0",
  "runtime": "php",
  "runtime_version": "8.1",
  "entrypoint": "main.php",
  "execution": {
    "mode": "sync",
    "timeout_seconds": 10,
    "memory_mb": 128
  },
  "network": {
    "enabled": false,
    "allowed_hosts": []
  },
  "secrets": [],
  "env": [],
  "env_mode": "user",
  "input_schema": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "title": "操作",
        "enum": [
          "序列化",
          "反序列化"
        ],
        "default": "序列化"
      },
      "text": {
        "type": "string",
        "title": "JSON / PHP 序列化内容",
        "maxLength": 100000,
        "default": ""
      }
    },
    "required": [
      "operation",
      "text"
    ]
  },
  "ui_schema": {
    "text": {
      "widget": "textarea",
      "rows": 6
    }
  },
  "output_schema": {
    "type": "json"
  }
}