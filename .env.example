TOOLDECK_PORT=18088
# Required: set a unique password, at least 12 characters.
TOOLDECK_ADMIN_PASSWORD=
# Required: generate 32 random bytes as 64 hexadecimal characters. Back up with the data volume.
TOOLDECK_MASTER_KEY=
# Optional OAuth resource-server integration (RFC 7662, HTTPS only).
TOOLDECK_OAUTH_INTROSPECTION_URL=
TOOLDECK_OAUTH_CLIENT_ID=
TOOLDECK_OAUTH_CLIENT_SECRET=
TOOLDECK_OAUTH_AUDIENCE=tooldeck

# Optional: independent DNS for networks using Fake-IP DNS. Empty uses system DNS.
TOOLDECK_EGRESS_DOH=

# Production file storage (local is only for development without BOS credentials).
TOOLDECK_STORAGE=bos
TOOLDECK_BOS_ENDPOINT=https://bj.bcebos.com
TOOLDECK_BOS_BUCKET=tooldeck
TOOLDECK_BOS_AK=
TOOLDECK_BOS_SK=
TOOLDECK_BOS_PREFIX=tooldeck

# Required for registration verification. Use tls (465) or starttls (587).
TOOLDECK_SMTP_HOST=smtp.qq.com
TOOLDECK_SMTP_PORT=465
TOOLDECK_SMTP_SECURITY=tls
TOOLDECK_SMTP_FROM=
TOOLDECK_SMTP_USERNAME=
# QQ mailbox SMTP authorization code, not the QQ account password.
TOOLDECK_SMTP_PASSWORD=
